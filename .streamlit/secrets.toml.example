# Streamlit Cloud Secrets 등록용 템플릿
# 실제 사용 시 Streamlit Cloud → App Settings → Secrets 에 그대로 붙여넣으세요.
# 이 파일은 가이드용이므로 더미 값 입력해두세요. (실제 .streamlit/secrets.toml은 .gitignore 처리됨)

# 대시보드 접근 비밀번호
DASHBOARD_PASSWORD = "강력한_랜덤_비밀번호_여기에"

# OpenAI API 키 (PDF 분석용)
OPENAI_API_KEY = "sk-..."

# 나라장터 공공데이터포털 API 키 (기관 검색용)
NARA_SERVICE_KEY = "..."

# GitHub Personal Access Token (자동 git push용)
# 권한: contents:write, actions:write (해당 저장소만)
GITHUB_TOKEN = "ghp_..."
GITHUB_REPO  = "minsung6333/nara-monitor"

# Git 커밋 작성자 정보
GIT_USER_NAME  = "Nara Dashboard Bot"
GIT_USER_EMAIL = "bot@clabi.ai"
